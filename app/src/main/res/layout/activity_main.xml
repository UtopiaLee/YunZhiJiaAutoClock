<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="云之家自动打卡"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态检查中..."
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打卡时间设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="上班时间:" />
        
        <EditText
            android:id="@+id/morningTimeEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="08:30"
            android:inputType="time" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="下班时间:" />
        
        <EditText
            android:id="@+id/eveningTimeEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="18:00"
            android:inputType="time" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="工作日选择"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <CheckBox
        android:id="@+id/mondayCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="周一"
        android:checked="true" />

    <CheckBox
        android:id="@+id/tuesdayCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="周二"
        android:checked="true" />

    <CheckBox
        android:id="@+id/wednesdayCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="周三"
        android:checked="true" />

    <CheckBox
        android:id="@+id/thursdayCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="周四"
        android:checked="true" />

    <CheckBox
        android:id="@+id/fridayCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="周五"
        android:checked="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保存设置"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="测试打卡"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/accessibilityButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开启无障碍服务"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打卡记录"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无打卡记录"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
